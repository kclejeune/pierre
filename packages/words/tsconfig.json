{
  "extends": "../../tsconfig.options.json",
  "include": [
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "benchmark/**/*.ts",
    "react/**/*.ts",
    "react/**/*.tsx",
    "html/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsdown.config.ts",
    "package.json"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["bun"],
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    // TypeScript 7.1 enforces isolatedDeclarations in this composite project
    // unless it is turned off here. words is the one package not written for
    // it yet (19 missing annotations, mostly in benchmark/); keep 7.0's
    // behavior until they are added.
    "isolatedDeclarations": false,
    "module": "ESNext"
  }
}
